{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Enabled": true,
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "Audience": ""
  },
  "BatchFile": {
    "MaxRecords": 50000,
    "MaxRequestBytes": 10485760,
    "TimeZone": "Africa/Johannesburg",
    "AllowedServiceTypes": [
      "SDV",
      "OneDay",
      "TwoDay"
    ]
  }
}
